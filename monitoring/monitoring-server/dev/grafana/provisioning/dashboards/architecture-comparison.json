          "legendFormat": "2xx (Success)",
          "refId": "A"
        },
        {
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "sum(rate(http_server_requests_seconds_count{application=\"refit-backend\", status=~\"4..\"}[5m]))",
          "legendFormat": "4xx (Client Error)",
          "refId": "B"
        },
        {
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
