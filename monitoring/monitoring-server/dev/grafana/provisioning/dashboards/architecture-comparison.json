      "id": 5,
      "options": {
        "legend": {
          "calcs": ["mean", "max"],
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "title": "API 엔드포인트별 p95 응답 시간",
      "description": "트래픽 믹스별(검색, 이력서, 내 정보, 채팅, AI 파싱) 응답 시간 추이",
      "type": "timeseries",
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "histogram_quantile(0.95, sum(rate(http_server_requests_seconds_bucket{application=\"refit-backend\", uri=~\"/api/.*search.*|/api/.*expert.*\"}[1m])) by (le)) * 1000",
          "legendFormat": "현직자 검색/조회",
          "refId": "A"
        },
        {
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "histogram_quantile(0.95, sum(rate(http_server_requests_seconds_bucket{application=\"refit-backend\", uri=~\"/api/.*resume.*\"}[1m])) by (le)) * 1000",
          "legendFormat": "이력서 목록 조회",
          "refId": "B"
        },
        {
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "histogram_quantile(0.95, sum(rate(http_server_requests_seconds_bucket{application=\"refit-backend\", uri=~\"/api/.*member.*|/api/.*user.*|/api/.*profile.*\"}[1m])) by (le)) * 1000",
          "legendFormat": "내 정보 조회",
          "refId": "C"
        },
        {
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "histogram_quantile(0.95, sum(rate(http_server_requests_seconds_bucket{application=\"refit-backend\", uri=~\"/api/.*chat.*\"}[1m])) by (le)) * 1000",
          "legendFormat": "채팅",
          "refId": "D"
        }
      ]
    },
