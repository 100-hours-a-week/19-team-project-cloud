      "type": "timeseries",
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "histogram_quantile(0.95, sum(rate(refit_http_server_requests_milliseconds_bucket{application=\"refit-backend\", uri=~\"/api/v1/experts.*\"}[1m])) by (le))",
          "legendFormat": "Expert Search (40%)",
          "refId": "A"
        },
        {
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "histogram_quantile(0.95, sum(rate(refit_http_server_requests_milliseconds_bucket{application=\"refit-backend\", uri=~\"/api/v1/users/me\"}[1m])) by (le))",
          "legendFormat": "My Info (20%)",
          "refId": "B"
        },
        {
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "histogram_quantile(0.95, sum(rate(refit_http_server_requests_milliseconds_bucket{application=\"refit-backend\", uri=~\"/api/v1/chats.*\"}[1m])) by (le))",
          "legendFormat": "Chat (25%)",
          "refId": "C"
        }
