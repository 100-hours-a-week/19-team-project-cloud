      "title": "CPU Utilization (CloudWatch)",
      "description": "CloudWatch CPUUtilization for ASG instances. Average = overall load, Maximum = hottest instance. Dashed line = ASG scale-out threshold (60%).",
      "type": "timeseries",
      "targets": [
        {
          "datasource": { "type": "cloudwatch", "uid": "cloudwatch" },
          "dimensions": { "AutoScalingGroupName": ["refit-prod-v2-backend-asg"] },
          "expression": "",
          "id": "",
          "label": "EC2 CPUUtilization (ASG avg)",
          "matchExact": true,
          "metricEditorMode": 0,
          "metricName": "CPUUtilization",
          "metricQueryType": 0,
          "namespace": "AWS/EC2",
          "period": "60",
          "queryMode": "Metrics",
          "refId": "A",
          "region": "default",
          "statistic": "Average"
        },
        {
          "datasource": { "type": "cloudwatch", "uid": "cloudwatch" },
          "dimensions": { "AutoScalingGroupName": ["refit-prod-v2-backend-asg"] },
          "expression": "",
          "id": "",
          "label": "EC2 CPUUtilization (ASG max)",
          "matchExact": true,
          "metricEditorMode": 0,
          "metricName": "CPUUtilization",
          "metricQueryType": 0,
          "namespace": "AWS/EC2",
          "period": "60",
          "queryMode": "Metrics",
          "refId": "B",
          "region": "default",
          "statistic": "Maximum"
