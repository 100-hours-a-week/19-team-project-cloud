        },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "title": "JVM Memory Usage",
      "description": "v2: Each instance JVM memory - distributed load keeps memory stable",
      "type": "timeseries",
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "refit_jvm_memory_used_bytes{application=\"refit-backend\", area=\"heap\"}",
          "legendFormat": "Heap Used {{instance}}",
          "refId": "A"
